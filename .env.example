# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM SECRETS
# Official Telegram Bot Token from @BotFather, used to validate HMAC signatures of WebApp initData.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# FIREBASE FIRESTORE SECRETS (REST API access via service account)
# Your Firebase Project ID
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
# Firebase Client Email from the Service Account JSON
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@xxxxx.iam.gserviceaccount.com"
# Firebase Private Key from the Service Account JSON (enclose in quotes, preserve newline characters)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ACCOUNT AGE ESTIMATION SERVICE API
# The external service URL to estimate account age based on Telegram ID (optional fallback exists)
ACCOUNT_AGE_API_URL="https://api.telegram-age-estimator.com/estimate"
# API key for the external account age service
ACCOUNT_AGE_API_KEY="YOUR_ACCOUNT_AGE_API_KEY"
